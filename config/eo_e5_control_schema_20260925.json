{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional per-case audited E5 saved responses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "question_id",
    "source_role",
    "source_gold",
    "predictions",
    "primary_membership",
    "dates",
    "slots",
    "completed_at",
    "source_sha256"
  ],
  "properties": {
    "run_id": {
      "const": "E5-EB-v0"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "source_role": {
      "const": "historical_model_output"
    },
    "source_gold": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "predictions": {
      "type": "object",
      "required": [
        "full/native",
        "pair/native",
        "later/native",
        "delta/native",
        "full/full_no_delta"
      ],
      "additionalProperties": false,
      "properties": {
        "full/native": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "2": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "3": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            }
          }
        },
        "pair/native": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "2": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "3": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            }
          }
        },
        "later/native": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "2": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "3": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            }
          }
        },
        "delta/native": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
                "no",
                null
              ]
            },
            "2": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "yes",
