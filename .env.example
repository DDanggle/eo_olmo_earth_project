# Copy to .env and keep the real values out of Git and chat.
DATA_GO_KR_SERVICE_KEY=
VWORLD_API_KEY=
VWORLD_API_DOMAIN=

# Optional P2 context layer only: apply at https://ecvam.neins.go.kr/api/apiWrite.do
# ECVAM_API_KEY=

# AI-Hub (aihub.or.kr) — 내국인 계정 전용. 발급: 오픈 API 안내 페이지의 "API key 발급" 버튼.
# 키는 등록 이메일로 수신된다. 특수문자가 있으므로 사용 시 홑따옴표로 감싼다.
# 주의: 키가 있어도 데이터셋별 "다운로드 승인"이 따로 필요하다 (상세페이지에서 신청).
AIHUB_APIKEY=

# 기상청 API 허브 (apihub.kma.go.kr) — data.go.kr 키와 **별개**임.
# 발급만으로는 부족하고 **API별 활용신청**이 따로 필요함 (2026-08-25 실측):
#   키 없음  -> 401 "유효한 인증키가 아닙니다"
#   키 있음  -> 403 "활용신청이 필요한 API 입니다"  (미신청 API 전부 동일)
KMA_API_HUB=
