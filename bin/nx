#!/usr/bin/env bash
# nexus 래퍼 — h100-setup(접속 전용 저장소)의 nexus CLI를 어디서든 호출한다.
#   nx up / nx status / nx ssh / nx run "..." / nx push <로컬경로> <원격상대경로>
# 서버 직접 SSH (긴 작업 실행용):  nx sh '명령'
H100="${H100_SETUP_DIR:-$HOME/dong/ai_projects/h100-setup}"
[ -x "$H100/nexus" ] || { echo "nexus를 찾을 수 없음: $H100 (H100_SETUP_DIR 로 지정)"; exit 1; }
if [ "${1:-}" = "sh" ]; then
    shift
    exec ssh -i "$H100/.state/id_container" -p 9922 -o StrictHostKeyChecking=no work@127.0.0.1 \
        "env -u PYTHONPATH bash -lc $(printf '%q' "$*")"
fi
cd "$H100" && exec ./nexus "$@"
